<Window x:Class="brownNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:brownNote"
        xmlns:helpers="clr-namespace:brownNote.Helpers"
        xmlns:controls="clr-namespace:brownNote.Controls"
        xmlns:audio="clr-namespace:brownNote.Audio"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="brownNote"
        Width="650"
        Height="730"
        MinWidth="420"
        MinHeight="420"
        WindowStartupLocation="Manual"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Loaded="MainWindow_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <helpers:AudioMetricConverter x:Key="AudioMetricConverter" />
        <Style x:Key="AudioValueEditorStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextAlignment" Value="Right" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ValueEditor_PreviewMouseLeftButtonDown" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BoundsEditorStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource AudioValueEditorStyle}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <EventSetter Event="GotFocus" Handler="AudioValueEditor_GotFocus" />
            <EventSetter Event="LostFocus" Handler="BoundsEditor_LostFocus" />
            <EventSetter Event="PreviewKeyDown" Handler="BoundsEditor_PreviewKeyDown" />
        </Style>
        <Style x:Key="BoundsLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BoundsDashStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Text" Value="-" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl x:Name="ModeTabs"
                    Grid.Row="0"
                    SelectionChanged="ModeTabs_SelectionChanged"
                    SizeChanged="ModeTabs_SizeChanged">
            <TabItem Header="Brown Noise" Tag="{x:Static audio:NoiseColor.Brown}" />
            <TabItem Header="Green Noise" Tag="{x:Static audio:NoiseColor.Green}" />
            <TabItem Header="White Noise" Tag="{x:Static audio:NoiseColor.White}" />
            <TabItem Header="Settings" Tag="Settings" />
            <TabItem Header="About" Tag="About" />
        </TabControl>
        <Grid Grid.Row="1">
            <Border x:Name="AboutPage"
                    Opacity="0"
                    Visibility="Collapsed"
                    Style="{StaticResource ContentPanelStyle}">
                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"
                           Width="128"
                           Height="128"
                           Margin="0,0,16,0"
                           Source="/Resources/icon512.png"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True" />
                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="AboutTitleText"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock x:Name="AboutVersionText"
                                   Margin="0,2,0,10"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Margin="0,0,0,4"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}">
                            <Run Text="Inspired by Jason Lewis's " />
                            <Hyperlink Style="{StaticResource AboutHyperlinkStyle}"
                                       NavigateUri="https://www.youtube.com/watch?v=RqzGzwTY-6w"
                                       RequestNavigate="AboutHyperlink_RequestNavigate">
                                '8 hour deep brown noise'
                            </Hyperlink>
                            <Run Text=" videos" />
                        </TextBlock>
                        <TextBlock Margin="0,0,0,10"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Pre-Release. Bugs and incomplete features expected." />
                        <TextBlock Margin="0,0,0,4">
                            <Hyperlink Style="{StaticResource AboutHyperlinkStyle}"
                                       NavigateUri="https://github.com/fosterbarnes/brownNote"
                                       RequestNavigate="AboutHyperlink_RequestNavigate">
                                github.com/fosterbarnes/brownNote
                            </Hyperlink>
                        </TextBlock>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0"
                                       Margin="0,0,12,6"
                                       FontWeight="SemiBold"
                                       Text="Install:" />
                            <TextBlock x:Name="AboutInstallPathText"
                                       Grid.Column="1"
                                       Margin="0,0,8,6"
                                       VerticalAlignment="Top"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="2"
                                    Margin="0,0,0,6"
                                    Style="{StaticResource AboutFolderButtonStyle}"
                                    Click="AboutOpenInstallLocation_Click"
                                    ToolTip="Open install location">
                                <materialDesign:PackIcon Kind="FolderArrowRight"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{StaticResource SecondaryTextBrush}" />
                            </Button>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,12,0"
                                       FontWeight="SemiBold"
                                       Text="Settings:" />
                            <TextBlock x:Name="AboutSettingsPathText"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Top"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="0"
                                    Style="{StaticResource AboutFolderButtonStyle}"
                                    Click="AboutOpenSettingsLocation_Click"
                                    ToolTip="Open settings location">
                                <materialDesign:PackIcon Kind="FolderArrowRight"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{StaticResource SecondaryTextBrush}" />
                            </Button>
                        </Grid>
                        <StackPanel Style="{StaticResource AboutCreditLineStackPanelStyle}">
                            <TextBlock Style="{StaticResource AboutCreditLinePartTextBlockStyle}">
                                <Run Text="made with &lt;3 by " Foreground="{StaticResource SecondaryTextBrush}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource AboutCreditLinePartTextBlockStyle}"
                                       Margin="0">
                                <Hyperlink Style="{StaticResource AboutHyperlinkStyle}"
                                           NavigateUri="https://github.com/fosterbarnes"
                                           RequestNavigate="AboutHyperlink_RequestNavigate">
                                    fosterbarnes
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel x:Name="SettingsPage"
                        VerticalAlignment="Top"
                        Opacity="0"
                        Visibility="Collapsed">
            <Border Style="{StaticResource ContentPanelStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="BoundsEditorsPanel">
                        <TextBlock Margin="0,0,0,12"
                                   FontWeight="SemiBold"
                                   Text="Frequency Ranges" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="4"
                                    Width="3"
                                    Margin="0,0,12,0"
                                    CornerRadius="1"
                                    Background="{StaticResource BrownKeyAccentBrush}" />
                            <Button Grid.Column="6"
                                    Grid.RowSpan="4"
                                    VerticalAlignment="Center"
                                    Margin="0"
                                    Content="Reset"
                                    Tag="{x:Static audio:NoiseColor.Brown}"
                                    Click="ResetBounds_Click"
                                    Style="{StaticResource NeutralButtonStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BoundsLabelStyle}" Text="Output Gain Range" />
                            <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource BoundsEditorStyle}" Tag="Brown/GainMin" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource BoundsDashStyle}" />
                            <TextBox Grid.Row="0" Grid.Column="4" Style="{StaticResource BoundsEditorStyle}" Tag="Brown/GainMax" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource BoundsLabelStyle}" Text="Low-Pass Range" />
                            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource BoundsEditorStyle}" Tag="Brown/LowPassMin" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource BoundsDashStyle}" />
                            <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource BoundsEditorStyle}" Tag="Brown/LowPassMax" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BoundsLabelStyle}" Text="High-Pass Range" />
                            <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource BoundsEditorStyle}" Tag="Brown/HighPassMin" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource BoundsDashStyle}" />
                            <TextBox Grid.Row="2" Grid.Column="4" Style="{StaticResource BoundsEditorStyle}" Tag="Brown/HighPassMax" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource BoundsLabelStyle}" Text="Brownness Range" />
                            <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource BoundsEditorStyle}" Tag="Brown/ColornessMin" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource BoundsDashStyle}" />
                            <TextBox Grid.Row="3" Grid.Column="4" Style="{StaticResource BoundsEditorStyle}" Tag="Brown/ColornessMax" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="4"
                                    Width="3"
                                    Margin="0,0,12,0"
                                    CornerRadius="1"
                                    Background="{StaticResource GreenKeyAccentBrush}" />
                            <Button Grid.Column="6"
                                    Grid.RowSpan="4"
                                    VerticalAlignment="Center"
                                    Margin="0"
                                    Content="Reset"
                                    Tag="{x:Static audio:NoiseColor.Green}"
                                    Click="ResetBounds_Click"
                                    Style="{StaticResource NeutralButtonStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BoundsLabelStyle}" Text="Output Gain Range" />
                            <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource BoundsEditorStyle}" Tag="Green/GainMin" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource BoundsDashStyle}" />
                            <TextBox Grid.Row="0" Grid.Column="4" Style="{StaticResource BoundsEditorStyle}" Tag="Green/GainMax" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource BoundsLabelStyle}" Text="Low-Pass Range" />
                            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource BoundsEditorStyle}" Tag="Green/LowPassMin" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource BoundsDashStyle}" />
                            <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource BoundsEditorStyle}" Tag="Green/LowPassMax" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BoundsLabelStyle}" Text="High-Pass Range" />
                            <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource BoundsEditorStyle}" Tag="Green/HighPassMin" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource BoundsDashStyle}" />
                            <TextBox Grid.Row="2" Grid.Column="4" Style="{StaticResource BoundsEditorStyle}" Tag="Green/HighPassMax" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource BoundsLabelStyle}" Text="Greenness Range" />
                            <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource BoundsEditorStyle}" Tag="Green/ColornessMin" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource BoundsDashStyle}" />
                            <TextBox Grid.Row="3" Grid.Column="4" Style="{StaticResource BoundsEditorStyle}" Tag="Green/ColornessMax" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="4"
                                    Width="3"
                                    Margin="0,0,12,0"
                                    CornerRadius="1"
                                    Background="{StaticResource WhiteKeyAccentBrush}" />
                            <Button Grid.Column="6"
                                    Grid.RowSpan="4"
                                    VerticalAlignment="Center"
                                    Margin="0"
                                    Content="Reset"
                                    Tag="{x:Static audio:NoiseColor.White}"
                                    Click="ResetBounds_Click"
                                    Style="{StaticResource NeutralButtonStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BoundsLabelStyle}" Text="Output Gain Range" />
                            <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource BoundsEditorStyle}" Tag="White/GainMin" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource BoundsDashStyle}" />
                            <TextBox Grid.Row="0" Grid.Column="4" Style="{StaticResource BoundsEditorStyle}" Tag="White/GainMax" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource BoundsLabelStyle}" Text="Low-Pass Range" />
                            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource BoundsEditorStyle}" Tag="White/LowPassMin" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource BoundsDashStyle}" />
                            <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource BoundsEditorStyle}" Tag="White/LowPassMax" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BoundsLabelStyle}" Text="High-Pass Range" />
                            <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource BoundsEditorStyle}" Tag="White/HighPassMin" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource BoundsDashStyle}" />
                            <TextBox Grid.Row="2" Grid.Column="4" Style="{StaticResource BoundsEditorStyle}" Tag="White/HighPassMax" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource BoundsLabelStyle}" IsEnabled="False" Text="Whiteness Range" />
                            <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource BoundsEditorStyle}" IsEnabled="False" Tag="White/ColornessMin" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource BoundsDashStyle}" IsEnabled="False" />
                            <TextBox Grid.Row="3" Grid.Column="4" Style="{StaticResource BoundsEditorStyle}" IsEnabled="False" Tag="White/ColornessMax" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
                <Button HorizontalAlignment="Right"
                        Width="Auto"
                        Margin="0,12,0,0"
                        Content="Reset to Default"
                        Click="ResetAllBounds_Click"
                        Style="{StaticResource NeutralButtonStyle}" />
            </StackPanel>
            <Grid x:Name="NoiseMachinePage"
                  Opacity="0"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource ContentPanelStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Output Gain" />
                            <TextBox x:Name="GeneratedVolumeValueEditor"
                                     Grid.Column="1"
                                     Style="{StaticResource AudioValueEditorStyle}"
                                     Tag="{Binding ElementName=GeneratedVolumeSlider}"
                                     GotFocus="AudioValueEditor_GotFocus"
                                     LostFocus="AudioValueEditor_LostFocus"
                                     PreviewKeyDown="AudioValueEditor_PreviewKeyDown">
                                <TextBox.Text>
                                    <MultiBinding Converter="{StaticResource AudioMetricConverter}" Mode="OneWay">
                                        <Binding ElementName="GeneratedVolumeSlider" Path="Value" />
                                        <Binding ElementName="GeneratedVolumeSlider" Path="(helpers:SliderMetric.Metric)" />
                                    </MultiBinding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>
                        <Slider x:Name="GeneratedVolumeSlider"
                                Minimum="0"
                                Maximum="10"
                                TickFrequency="0.01"
                                IsSnapToTickEnabled="True"
                                helpers:SliderMetric.Metric="{x:Static helpers:AudioMetric.Percentage}"
                                Value="1"
                                ValueChanged="GeneratedVolumeSlider_ValueChanged" />
                        <Grid Margin="0,18,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Low-Pass Cutoff" />
                            <TextBox x:Name="LowPassCutoffValueEditor"
                                     Grid.Column="1"
                                     Style="{StaticResource AudioValueEditorStyle}"
                                     Tag="{Binding ElementName=LowPassCutoffSlider}"
                                     GotFocus="AudioValueEditor_GotFocus"
                                     LostFocus="AudioValueEditor_LostFocus"
                                     PreviewKeyDown="AudioValueEditor_PreviewKeyDown">
                                <TextBox.Text>
                                    <MultiBinding Converter="{StaticResource AudioMetricConverter}" Mode="OneWay">
                                        <Binding ElementName="LowPassCutoffSlider" Path="Frequency" />
                                        <Binding ElementName="LowPassCutoffSlider" Path="(helpers:SliderMetric.Metric)" />
                                    </MultiBinding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>
                        <controls:LogSlider x:Name="LowPassCutoffSlider"
                                            FrequencyMinimum="80"
                                            FrequencyMaximum="24000"
                                            Frequency="120"
                                            helpers:SliderMetric.Metric="{x:Static helpers:AudioMetric.Hertz}"
                                            FrequencyChanged="LowPassCutoffSlider_FrequencyChanged" />
                        <controls:FrequencyScale Margin="0,2,0,0"
                                                 Slider="{Binding ElementName=LowPassCutoffSlider}" />
                        <Grid Margin="0,18,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="High-Pass Cutoff" />
                            <TextBox x:Name="HighPassCutoffValueEditor"
                                     Grid.Column="1"
                                     Style="{StaticResource AudioValueEditorStyle}"
                                     Tag="{Binding ElementName=HighPassCutoffSlider}"
                                     GotFocus="AudioValueEditor_GotFocus"
                                     LostFocus="AudioValueEditor_LostFocus"
                                     PreviewKeyDown="AudioValueEditor_PreviewKeyDown">
                                <TextBox.Text>
                                    <MultiBinding Converter="{StaticResource AudioMetricConverter}" Mode="OneWay">
                                        <Binding ElementName="HighPassCutoffSlider" Path="Frequency" />
                                        <Binding ElementName="HighPassCutoffSlider" Path="(helpers:SliderMetric.Metric)" />
                                    </MultiBinding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>
                        <controls:LogSlider x:Name="HighPassCutoffSlider"
                                            FrequencyMinimum="10"
                                            FrequencyMaximum="1000"
                                            Frequency="17"
                                            helpers:SliderMetric.Metric="{x:Static helpers:AudioMetric.Hertz}"
                                            FrequencyChanged="HighPassCutoffSlider_FrequencyChanged" />
                        <controls:FrequencyScale Margin="0,2,0,0"
                                                 Slider="{Binding ElementName=HighPassCutoffSlider}" />
                        <Grid x:Name="ColornessControl"
                              Margin="0,18,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ColornessLabel" Text="Brownness" />
                            <TextBox x:Name="ColornessValueEditor"
                                     Grid.Column="1"
                                     Style="{StaticResource AudioValueEditorStyle}"
                                     Tag="{Binding ElementName=ColornessSlider}"
                                     GotFocus="AudioValueEditor_GotFocus"
                                     LostFocus="AudioValueEditor_LostFocus"
                                     PreviewKeyDown="AudioValueEditor_PreviewKeyDown">
                                <TextBox.Text>
                                    <MultiBinding Converter="{StaticResource AudioMetricConverter}" Mode="OneWay">
                                        <Binding ElementName="ColornessSlider" Path="Value" />
                                        <Binding ElementName="ColornessSlider" Path="(helpers:SliderMetric.Metric)" />
                                    </MultiBinding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>
                        <Slider x:Name="ColornessSlider"
                                Minimum="0"
                                Maximum="100"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                helpers:SliderMetric.Metric="{x:Static helpers:AudioMetric.WholePercentage}"
                                Value="67"
                                ValueChanged="ColornessSlider_ValueChanged" />
                        <Grid Margin="0,18,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Noise Density" />
                            <TextBox x:Name="NoiseDensityValueEditor"
                                     Grid.Column="1"
                                     Style="{StaticResource AudioValueEditorStyle}"
                                     Tag="{Binding ElementName=NoiseDensitySlider}"
                                     GotFocus="AudioValueEditor_GotFocus"
                                     LostFocus="AudioValueEditor_LostFocus"
                                     PreviewKeyDown="AudioValueEditor_PreviewKeyDown">
                                <TextBox.Text>
                                    <MultiBinding Converter="{StaticResource AudioMetricConverter}" Mode="OneWay">
                                        <Binding ElementName="NoiseDensitySlider" Path="Value" />
                                        <Binding ElementName="NoiseDensitySlider" Path="(helpers:SliderMetric.Metric)" />
                                    </MultiBinding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>
                        <Slider x:Name="NoiseDensitySlider"
                                Minimum="1"
                                Maximum="12"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                helpers:SliderMetric.Metric="{x:Static helpers:AudioMetric.Count}"
                                Value="4"
                                ValueChanged="NoiseDensitySlider_ValueChanged" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Style="{StaticResource ContentPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="Visualizer" />
                        <ComboBox x:Name="VisualizerModeComboBox"
                                  Width="130"
                                  HorizontalAlignment="Right"
                                  SelectionChanged="VisualizerModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Waveform" />
                            <ComboBoxItem Content="Spectrum" />
                            <ComboBoxItem Content="Level Meter" />
                        </ComboBox>
                        <controls:NoiseVisualizer x:Name="Visualizer"
                                                  Grid.Row="1"
                                                  Margin="0,12,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2"
                Margin="0,14,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource TransportPanelStyle}">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="BrownKey"
                              ToolTip="Brown"
                              Tag="{x:Static audio:NoiseColor.Brown}"
                              Background="{StaticResource BrownKeyBrush}"
                              helpers:KeyAccent.Brush="{StaticResource BrownKeyAccentBrush}"
                              Click="ColorKey_Click"
                              Style="{StaticResource TransportKeyBaseStyle}" />
                <ToggleButton x:Name="GreenKey"
                              ToolTip="Green"
                              Tag="{x:Static audio:NoiseColor.Green}"
                              Background="{StaticResource GreenKeyBrush}"
                              helpers:KeyAccent.Brush="{StaticResource GreenKeyAccentBrush}"
                              Click="ColorKey_Click"
                              Style="{StaticResource TransportKeyBaseStyle}" />
                <ToggleButton x:Name="WhiteKey"
                              ToolTip="White"
                              Tag="{x:Static audio:NoiseColor.White}"
                              Background="{StaticResource WhiteKeyBrush}"
                              helpers:KeyAccent.Brush="{StaticResource WhiteKeyAccentBrush}"
                              Click="ColorKey_Click"
                              Style="{StaticResource TransportKeyBaseStyle}" />
                <RadioButton x:Name="StopKey"
                             GroupName="Transport"
                             ToolTip="Stop"
                             IsChecked="True"
                             Checked="StopKey_Checked"
                             Click="TransportKey_Click"
                             Style="{StaticResource TransportKeyStyle}">
                    <materialDesign:PackIcon Kind="Stop" Width="10" Height="10" />
                </RadioButton>
                <RadioButton x:Name="PlayKey"
                             GroupName="Transport"
                             ToolTip="Play"
                             Checked="PlayKey_Checked"
                             Click="TransportKey_Click"
                             Style="{StaticResource TransportKeyStyle}">
                    <materialDesign:PackIcon Kind="Play" Width="10" Height="10" />
                </RadioButton>
            </StackPanel>
        </Border>
    </Grid>
</Window>

