<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:brownNote.Helpers">
    <Style x:Key="FocusVisualStyle" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{StaticResource FocusBrush}"
                            BorderThickness="2"
                            Margin="-2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid>
                        <Border Margin="{StaticResource SegmentStripMargin}"
                                Background="{StaticResource ControlAltBrush}"
                                CornerRadius="{StaticResource SmallCornerRadius}"
                                ClipToBounds="True"
                                Height="{StaticResource SegmentHeight}">
                            <Grid x:Name="HeaderHost" ClipToBounds="True">
                                <Grid x:Name="TabDividers" IsHitTestVisible="False" />
                                <Border x:Name="SelectedTabIndicator"
                                        Background="{StaticResource AccentStrongBrush}"
                                        BorderBrush="{StaticResource AccentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource SmallCornerRadius}"
                                        HorizontalAlignment="Left"
                                        IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="SelectedTabIndicatorTransform" />
                                    </Border.RenderTransform>
                                </Border>
                                <UniformGrid
                                             Rows="1"
                                             IsItemsHost="True" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="{StaticResource TabPadding}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Margin="0"
                                SnapsToDevicePixels="True" />
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Margin" Value="{StaticResource ControlMargin}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TransportKeyBaseStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="56" />
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="#262626" />
        <Setter Property="Background" Value="{StaticResource TransportKeyBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Height="66">
                        <Border Background="#161616"
                                BorderBrush="#1A1A1A"
                                BorderThickness="1,0"
                                CornerRadius="4"
                                ClipToBounds="True">
                            <Border.OpacityMask>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Border Width="56"
                                                Height="66"
                                                CornerRadius="4"
                                                Background="Black" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.OpacityMask>
                            <Grid>
                                <Grid x:Name="Key"
                                      VerticalAlignment="Bottom">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="55" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="#1CFFFFFF"
                                            BorderThickness="0,1,0,0"
                                            CornerRadius="4,4,0,0">
                                        <Grid>
                                            <Border Height="20"
                                                    VerticalAlignment="Center"
                                                    Margin="0,8,0,0">
                                                <Border.Background>
                                                    <LinearGradientBrush MappingMode="Absolute"
                                                                         StartPoint="0,0"
                                                                         EndPoint="0,2"
                                                                         SpreadMethod="Repeat">
                                                        <GradientStop Offset="0" Color="#16FFFFFF" />
                                                        <GradientStop Offset="0.5" Color="#16FFFFFF" />
                                                        <GradientStop Offset="0.5" Color="#1C000000" />
                                                        <GradientStop Offset="1" Color="#1C000000" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Width="36"
                                                    Height="4"
                                                    Margin="0,5,0,0"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Center"
                                                    BorderBrush="#1CFFFFFF"
                                                    BorderThickness="0,0,0,1">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="#262626" />
                                                        <GradientStop Offset="1" Color="#3A3A3A" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="{x:Type Grid}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding (helpers:KeyAccent.Brush), RelativeSource={RelativeSource TemplatedParent}}"
                                                                             Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Border Background="{Binding (helpers:KeyAccent.Brush), RelativeSource={RelativeSource TemplatedParent}}" />
                                                    <Border>
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Offset="0" Color="#60000000" />
                                                                <GradientStop Offset="1" Color="#00000000" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Grid Width="34"
                                                  Height="34"
                                                  Margin="0,8,0,0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Offset="0" Color="#3A3A3A" />
                                                            <GradientStop Offset="0.6" Color="#6A6A6A" />
                                                            <GradientStop Offset="1" Color="#B8B8B8" />
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Ellipse Margin="1.5">
                                                    <Ellipse.Fill>
                                                        <RadialGradientBrush RadiusX="0.012"
                                                                             RadiusY="0.012"
                                                                             SpreadMethod="Reflect">
                                                            <GradientStop Offset="0" Color="#949494" />
                                                            <GradientStop Offset="1" Color="#8A8A8A" />
                                                        </RadialGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Grid IsHitTestVisible="False">
                                                    <Grid.Clip>
                                                        <EllipseGeometry Center="17,17" RadiusX="15.5" RadiusY="15.5" />
                                                    </Grid.Clip>
                                                    <Rectangle>
                                                        <Rectangle.Fill>
                                                            <DrawingBrush Stretch="Fill">
                                                                <DrawingBrush.Drawing>
                                                                    <DrawingGroup>
                                                                        <GeometryDrawing Brush="#59FFFFFF"
                                                                                         Geometry="M0.5,0.5 L0,0.25 L0,0 L0.25,0 Z M0.5,0.5 L1,0.75 L1,1 L0.75,1 Z" />
                                                                        <GeometryDrawing Brush="#33000000"
                                                                                         Geometry="M0.5,0.5 L0.75,0 L1,0 L1,0.25 Z M0.5,0.5 L0.25,1 L0,1 L0,0.75 Z" />
                                                                    </DrawingGroup>
                                                                </DrawingBrush.Drawing>
                                                            </DrawingBrush>
                                                        </Rectangle.Fill>
                                                        <Rectangle.Effect>
                                                            <BlurEffect Radius="5" />
                                                        </Rectangle.Effect>
                                                    </Rectangle>
                                                </Grid>
                                                <Grid IsHitTestVisible="False">
                                                    <Grid.Clip>
                                                        <EllipseGeometry Center="17,17" RadiusX="15.5" RadiusY="15.5" />
                                                    </Grid.Clip>
                                                    <Ellipse Margin="0"
                                                             Stroke="#50000000"
                                                             StrokeThickness="3">
                                                        <Ellipse.RenderTransform>
                                                            <TranslateTransform Y="1" />
                                                        </Ellipse.RenderTransform>
                                                        <Ellipse.Effect>
                                                            <BlurEffect Radius="4" />
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                                <Viewbox Width="14" Height="14">
                                                    <ContentPresenter>
                                                        <ContentPresenter.Effect>
                                                            <DropShadowEffect Color="#FFFFFF"
                                                                              Direction="270"
                                                                              ShadowDepth="0.8"
                                                                              BlurRadius="0"
                                                                              Opacity="0.3" />
                                                        </ContentPresenter.Effect>
                                                    </ContentPresenter>
                                                </Viewbox>
                                            </Grid>
                                            <Border x:Name="HoverShade"
                                                    Background="#FFFFFF"
                                                    Opacity="0" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="Skirt"
                                            Grid.Row="1"
                                            Height="11"
                                            CornerRadius="0,0,4,4"
                                            Background="{TemplateBinding Background}">
                                        <Border CornerRadius="0,0,4,4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#16FFFFFF" />
                                                    <GradientStop Offset="0.15" Color="#13000000" />
                                                    <GradientStop Offset="1" Color="#64000000" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <Border x:Name="PressShade"
                                            CornerRadius="4,4,0,0"
                                            Background="#000000"
                                            IsHitTestVisible="False"
                                            Opacity="0" />
                                </Grid>
                                <Grid x:Name="SlotShadow"
                                      IsHitTestVisible="False"
                                      Opacity="0">
                                    <Border Height="14" VerticalAlignment="Top">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#80000000" />
                                                <GradientStop Offset="0.35" Color="#30000000" />
                                                <GradientStop Offset="1" Color="#00000000" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Skirt"
                                                         Storyboard.TargetProperty="Height"
                                                         To="9"
                                                         Duration="0:0:0.11">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressShade"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.12"
                                                         Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="SlotShadow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Skirt"
                                                         Storyboard.TargetProperty="Height"
                                                         To="11"
                                                         Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressShade"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="SlotShadow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HoverShade" Property="Opacity" Value="0.04" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TransportKeyStyle"
           TargetType="{x:Type RadioButton}"
           BasedOn="{StaticResource TransportKeyBaseStyle}" />

    <Style x:Key="TransportPanelStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="#1F1F1F" />
        <Setter Property="BorderBrush" Value="#2A2A2A" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="NeutralButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Width" Value="{StaticResource NeutralButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource NeutralButtonHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource NeutralButtonHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="{StaticResource ControlMargin}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                            Background="{StaticResource ControlAltBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Height" Value="{StaticResource NeutralButtonHeight}" />
        <Setter Property="Padding" Value="8,0,26,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="ToggleBorder"
                                            Background="{StaticResource ControlAltBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="1"
                                            SnapsToDevicePixels="True">
                                        <Path Margin="0,0,10,0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Data="M0,0 L4,4 L8,0"
                                              Stroke="{StaticResource SecondaryTextBrush}"
                                              StrokeThickness="1.5" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource PressedBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,2,0,0"
                                    Padding="2"
                                    Background="{StaticResource ControlAltBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="1">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ContentPanelStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SurfaceLoweredBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource ContentPanelPadding}" />
    </Style>

    <Style x:Key="AboutFolderButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource SmallCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AboutHyperlinkStyle" TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="{x:Static TextDecorations.Underline}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AboutCreditLineStackPanelStyle" TargetType="{x:Type StackPanel}">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <Style x:Key="AboutCreditLinePartTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>

